DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/reqlint
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=ganti-ini
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
BCRYPT_ROUNDS=12
MAX_UPLOAD_MB=10
MAX_TEXT_CHARS=50000
TEMP_DIR=./storage/cache
TEMP_TTL_MINUTES=60
SLM_PROVIDER=ollama            # ollama | openai_compatible | mock
SLM_BASE_URL=http://localhost:11434
SLM_MODEL=phi3:mini
SLM_TIMEOUT_SECONDS=4          # naikkan saat dev di laptop (PERF-2 target total <5 dtk)
AUDIT_EXECUTION_MODE=celery    # celery | inline  (inline = FastAPI BackgroundTasks, memudahkan dev)
CORS_ORIGINS=http://localhost:3000
